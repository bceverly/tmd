# ---------------------------------------------------------------------------
# tmd — C (gnu make), Debian packaging, Launchpad PPA
#
# The rule this file follows: everything here is regenerated by `make`. If
# something has to be committed to be built — the source, the packaging
# metadata, the generated manpage — it is deliberately not listed.
# ---------------------------------------------------------------------------

# --- Build output (make build / make clean) --------------------------------
bin/
obj/
*.o
*.a
*.so
*.so.*
*.d
*.lo
*.la
# A binary left in the tree by a hand-run compiler, rather than in bin/.
/tmd
core
core.*
vgcore.*
*.core

# --- Coverage (make coverage) ----------------------------------------------
# docs/badges/coverage.svg is deliberately NOT ignored: it is committed, and
# the README references it by relative path so the page renders offline.
.coverage/
*.gcno
*.gcda
*.gcov
coverage.xml
coverage.json
coverage.info
htmlcov/

# --- Sanitizer and analyzer output -----------------------------------------
# ASan/UBSan/valgrind logs and the scanner reports scripts/security.sh writes.
.security-reports/
*.asan.log*
*.ubsan.log*
*.valgrind.log
*.msan.log*
cppcheck-report.xml
scan-build-report/
# clang's compilation database, produced by bear for clang-tidy.
compile_commands.json
.cache/

# --- Analyzer and sanitizer working directories ----------------------------
# make lint and make test-memory; both hold build logs and scratch binaries.
.lint/
.sanitize/

# --- Fuzzing (make fuzz) ---------------------------------------------------
# The corpus is generated; a crash file is a bug report to keep by hand, not in
# the repository, because it is the input that reproduces a vulnerability.
.fuzz/
fuzz-*.log
crash-*
leak-*
timeout-*
oom-*

# --- Test scratch ----------------------------------------------------------
# The end-to-end tests build their archives in a mktemp directory and clean up
# after themselves. These catch a run that was interrupted before it could.
tests/cli/tmp/
*.tar.test
tmd-test-*

# --- Debian packaging ------------------------------------------------------
#
# debian/ itself IS committed — it is the packaging source, and Launchpad
# builds from it. Only the generated parts are ignored:
#
#   changelog   written by scripts/build-deb.sh from the VERSION file, so the
#               version lives in one place rather than two
#   debian/tmd/ the staging tree debhelper assembles the package from
debian/changelog
debian/tmd/
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/*.substvars
debian/*.debhelper
debian/*.debhelper.log
# dpkg-buildpackage writes the finished package one level up, but a build run
# from inside a checked-out parent would otherwise leave these here.
*.deb
*.ddeb
*.dsc
*.changes
*.buildinfo
*.build
*.upload
*.orig.tar.*
*.debian.tar.*

# --- Signing material ------------------------------------------------------
# Nothing here should ever be committed: the PPA signing key lives in the
# developer's keyring and in GitHub secrets, and nowhere else.
*.gpg
*.asc
!debian/copyright
secring.*
*.pem
*.key

# --- Editors, tooling and the OS -------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
\#*\#
.\#*
tags
TAGS
cscope.*
.ccls-cache/
.clangd/
.DS_Store
Thumbs.db
desktop.ini
