# What must NOT go into the source package.
#
# `3.0 (native)` tars the whole directory, and a working checkout accumulates
# build output, coverage data, sanitizer logs and a fuzzing corpus — none of
# which belongs in a source package, and none of which dpkg-source can know
# about on its own. What DOES belong is everything a Launchpad builder needs to
# build from scratch: the sources, the Makefile, the scripts, the tests and the
# generated manpage.
tar-ignore = .git
tar-ignore = .git/*
tar-ignore = .github
tar-ignore = .github/*
tar-ignore = bin
tar-ignore = bin/*
tar-ignore = obj
tar-ignore = obj/*
tar-ignore = .coverage
tar-ignore = .coverage/*
tar-ignore = .sanitize
tar-ignore = .sanitize/*
tar-ignore = .lint
tar-ignore = .lint/*
tar-ignore = .fuzz
tar-ignore = .fuzz/*
tar-ignore = .security-reports
tar-ignore = .security-reports/*
tar-ignore = *.o
tar-ignore = *.d
tar-ignore = *.gcno
tar-ignore = *.gcda
tar-ignore = *.gcov
tar-ignore = debian/tmd
tar-ignore = debian/tmd/*
tar-ignore = debian/.debhelper
tar-ignore = debian/.debhelper/*
tar-ignore = debian/files
tar-ignore = debian/*.substvars
tar-ignore = debian/*.debhelper.log
tar-ignore = debian/debhelper-build-stamp
